# Copy to .env.local (gitignored) for local runs. Builds take these from the
# EAS environments instead (eas env:set ... --environment preview/production).

# Map tiles for meeting points and Discover. CARTO needs ?key=... (carto.com/basemaps/apikey);
# without one every tile reads "API key required".
EXPO_PUBLIC_MAP_TILES=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png?key=
# Only if you switch tile provider: its credit line.
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO

# Leave unset locally: the app finds the API on the machine running Expo.
# EXPO_PUBLIC_API_URL=https://api-buddy.example.com
# Base for shared activity links, if not the API's domain.
# EXPO_PUBLIC_SHARE_URL=https://buddy.example.com
