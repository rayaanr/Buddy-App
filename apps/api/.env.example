# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=7400
LOG_LEVEL=info
# Readable logs for local development; leave off in Docker and production.
LOG_PRETTY=true

DATABASE_URL=postgres://postgres:postgres@localhost:7432/buddy

# Public URL of this API (the app talks to it).
BETTER_AUTH_URL=http://localhost:7400
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_SCHEME=buddy

# Leave empty in development: sign-in codes are printed to the API log.
RESEND_API_KEY=
EMAIL_FROM="Buddy <hello@example.com>"
# Shown on /privacy and /terms for questions and data requests.
CONTACT_EMAIL=
# New reports are emailed here (set it in production); otherwise only logged.
MODERATION_EMAIL=

# Cloudflare R2: uploads stay disabled until these are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Browser origins allowed to call the API, comma-separated (Expo web dev only).
WEB_ORIGINS=http://localhost:7481

# Venue search for meeting points: osm (OpenStreetMap via Photon, default),
# google (Places API; needs GOOGLE_PLACES_API_KEY) or towns (offline).
VENUE_PROVIDER=osm
# Point at your own Photon server for heavy use; the public one asks for fair use.
PHOTON_URL=https://photon.komoot.io
GOOGLE_PLACES_API_KEY=

# Reverse proxies in front of the API, so rate limits see the real client IP.
# 1 for Caddy/nginx on the same server, 2 for Cloudflare then Caddy; 0 if
# clients connect directly (X-Forwarded-For is then ignored).
TRUSTED_PROXY_HOPS=0
