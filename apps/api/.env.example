# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/buddy

# Public URL of this API (the app talks to it).
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_SCHEME=buddy

# Leave empty in development: sign-in codes are printed to the API log.
RESEND_API_KEY=
EMAIL_FROM="Buddy <hello@example.com>"
# New reports are emailed here (set it in production); otherwise only logged.
MODERATION_EMAIL=

# Cloudflare R2: uploads stay disabled until these are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Browser origins allowed to call the API, comma-separated (Expo web dev only).
WEB_ORIGINS=
