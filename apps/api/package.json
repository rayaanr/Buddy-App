{
  "name": "@buddy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "@types/ws": "^8.18.1",
    "auth": "1.7.7"
  },
  "dependencies": {
    "@buddy/shared": "*",
    "hono": "^4.13.13",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "pino": "^10.4.0",
    "zod": "^4.6.5",
    "ws": "^8.22.0",
    "@better-auth/expo": "^1.7.7"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts --yes",
    "lint": "eslint ."
  }
}
