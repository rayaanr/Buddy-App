{
  "name": "buddy",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api",
    "setup": "node scripts/dev.mjs --setup",
    "mobile": "bun run --filter @buddy/mobile start",
    "api": "bun run --filter @buddy/api dev",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "bun run --filter @buddy/api db:migrate",
    "db:seed": "bun run --filter @buddy/api db:seed",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.71.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=22"
  }
}
