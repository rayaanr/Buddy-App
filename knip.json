{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["design/**", ".agents/**"],
  "ignoreDependencies": [
    "@jest/globals",
    "postcss",
    "react-native-css-interop",
    "@tailwindcss/container-queries",
    "pino-pretty"
  ],
  "workspaces": {
    "apps/api": {
      "entry": ["scripts/**/*.ts"]
    },
    "apps/mobile": {
      "metro": false,
      "entry": ["metro.config.js"]
    },
    "packages/shared": {},
    "e2e": {
      "entry": ["prepare-db.ts", "tests/**/*.spec.ts"]
    },
    "load": {
      "entry": ["k6/*.js"],
      "ignoreDependencies": ["k6"]
    }
  }
}
