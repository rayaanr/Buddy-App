# Cloudflare terminates HTTPS and a Cloudflare Tunnel (the cloudflared
# service) brings requests here over the Docker network, so Caddy publishes
# no ports and serves plain HTTP. Hostnames come from DOMAIN in infra/.env;
# the tunnel's public hostnames in Cloudflare must match them.
{
	servers {
		# Only cloudflared reaches Caddy. Keep the X-Forwarded-For it passes
		# on (the client, as Cloudflare saw it) so the API's rate limits see
		# real addresses; see TRUSTED_PROXY_HOPS.
		trusted_proxies static private_ranges
	}
}

# The API: the copies deploy.sh started (API_REPLICAS), listed in
# api-upstreams, which it writes before reloading Caddy. New requests go to
# the least busy healthy copy; chat WebSockets stay on the one they opened on.
http://api-buddy.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy {
		import api-upstreams
		lb_policy least_conn
		health_uri /health
		health_interval 5s
		health_timeout 2s
		# A copy that just stopped or failed: try another for up to 10 s.
		lb_try_duration 10s
		lb_try_interval 100ms
		fail_duration 10s
		transport http {
			dial_timeout 2s
		}
	}
}

# The landing page (landing/index.html, mounted read-only).
http://buddy.{$DOMAIN} {
	encode zstd gzip
	root * /srv/landing
	file_server
	header Cache-Control "public, max-age=300"
}
