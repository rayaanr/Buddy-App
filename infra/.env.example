# Production settings. Copy to infra/.env on the server; never commit .env.

# The primary domain. The API is served at api-buddy.<DOMAIN> and the landing
# page at buddy.<DOMAIN>, through the Cloudflare Tunnel below.
DOMAIN=example.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Its public
# hostnames api-buddy.<DOMAIN> and buddy.<DOMAIN> both point at http://caddy:80.
TUNNEL_TOKEN=

# Copies of the API to run (each is one Node process, so one CPU core and
# about 150 MB of memory). 2 keeps the API up while one restarts; raise it on
# a server with more cores. The copies share Redis (in the compose file).
API_REPLICAS=2

# Database password. Letters and digits only (it goes into a URL):
#   openssl rand -hex 24
DB_PASSWORD=

# Signs sessions. At least 32 random characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-in codes are emailed through Resend. Required: the API won't start
# in production without it. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Buddy <hello@example.com>"

# Google sign-in: an OAuth client of type "Web application" in Google Cloud,
# with redirect URI https://api-buddy.<DOMAIN>/api/auth/callback/google.
# Leave both empty to offer email codes only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shown on /privacy and /terms; reports from the app are emailed to MODERATION_EMAIL.
CONTACT_EMAIL=hello@example.com
MODERATION_EMAIL=
# Who can act on reports in the app (Settings → Moderation), comma-separated.
ADMIN_EMAILS=

# Photo uploads (Cloudflare R2). Uploads stay off until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Sentry project DSN for crash reports; leave empty to send nothing.
SENTRY_DSN=

# Optional push security token from the Expo project.
EXPO_ACCESS_TOKEN=

# Optional. Venue search for meeting points: osm (OpenStreetMap via the public
# Photon server, the default; no key), google (Places API; needs
# GOOGLE_PLACES_API_KEY) or towns (offline). PHOTON_URL: your own Photon server.
# VENUE_PROVIDER=osm
# PHOTON_URL=https://photon.komoot.io
# GOOGLE_PLACES_API_KEY=

# Proxies in front of the API: cloudflared and Caddy. Leave at 2.
TRUSTED_PROXY_HOPS=2

LOG_LEVEL=info
